# Sentry Internal Integration credentials
# Found at: Settings > Developer Settings > Your Integration > Credentials
SENTRY_CLIENT_SECRET=your-sentry-client-secret-here

# Anthropic API key for the Claude Agent SDK
ANTHROPIC_API_KEY=sk-ant-xxxxx

# Path to the project codebase the agent should investigate
PROJECT_CWD=/path/to/your/project

# Server configuration
PORT=3000

# Agent configuration
AGENT_MAX_TURNS=30
AGENT_MAX_BUDGET_USD=2.00
AGENT_MODEL=sonnet

# Maximum concurrent agents (prevents runaway costs)
MAX_CONCURRENT_AGENTS=3
